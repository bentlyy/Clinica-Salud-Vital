{
  "name": "clinic-backend",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": "20.x"
  },
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx src/app.ts",
    "start": "node dist/app.js",
    "start:gc": "node --expose-gc --max-old-space-size=400 dist/app.js",
    "start:inspect": "node --inspect=9229 --max-old-space-size=400 dist/app.js",
    "migrate": "node dist/scripts/migrate.js",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=html",
    "profile:doctor": "clinic doctor --on-port 'npx tsx src/app.ts' -- node --expose-gc --max-old-space-size=400 dist/app.js",
    "profile:flame": "clinic flame --on-port 'npx tsx src/app.ts' -- node --expose-gc --max-old-space-size=400 dist/app.js",
    "profile:heapprofiler": "clinic heapprofiler --on-port 'npx tsx src/app.ts' -- node --expose-gc --max-old-space-size=400 dist/app.js",
    "profile:dev": "clinic doctor -- npx tsx src/app.ts",
    "profile:gc": "node --expose-gc --trace-gc dist/app.js 2> logs/gc-trace.log",
    "db:table-sizes": "tsx -e \"import('./src/shared/db-monitor.service.js').then(m => m.dbMonitor.logTableSizesToFile()).then(() => process.exit())\"",
    "db:monitor": "tsx src/app.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:profiling": "pm2 start ecosystem.config.cjs --env profiling",
    "pm2:stop": "pm2 stop clinic-api",
    "pm2:logs": "pm2 logs clinic-api",
    "pm2:monit": "pm2 monit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.56.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "@types/twilio": "^3.19.2",
    "@types/xlsx": "^0.0.35",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "hi-base32": "^0.5.1",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pg": "^8.18.0",
    "sanitize-html": "^2.17.4",
    "stripe": "^22.1.1",
    "twilio": "^5.6.0",
    "typescript": "^5.8.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "vitest": "^4.1.5"
  }
}
