{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "backend",
  "instructions": ["prompts-secuenciales.md"],
  "agent": {
    "backend": {
      "description": "Desarrolla APIs, rutas, middlewares y lógica de negocio del backend Express/TypeScript",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6"
    }
  },
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:STITCH_API_KEY}"
      }
    }
  }
}
