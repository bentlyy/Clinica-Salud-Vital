# ============================================================
# .env.example — Copy to .env and fill in real values
# ============================================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/clinic
# Read replica (optional, for production with Oracle Cloud)
# DATABASE_URL_READ_ONLY=postgresql://USER:PASSWORD@READ_REPLICA_HOST:5432/clinic
DB_POOL_MAX=25
DB_CA_CERT=                      # PEM certificate for RDS/Oracle Cloud SSL
DB_SSL_REJECT_UNAUTHORIZED=true

# Server
PORT=3000
NODE_ENV=development             # Set to 'production' on Render
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
COOKIE_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# Email (SMTP)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
# SENDGRID_API_KEY=SG.REPLACE_WITH_REAL_KEY

# Error monitoring
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# TOTP (2FA)
TOTP_ISSUER=ClinicApp

# SMS (Twilio) — leave empty to use console logging
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Multi-tenancy
DEFAULT_TENANT_ID=default
APP_LOCALE=es

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_REAL_KEY
STRIPE_WEBHOOK_SECRET=

# reCAPTCHA (disable in local dev)
# RECAPTCHA_SECRET_KEY=
# VITE_RECAPTCHA_SITE_KEY=

# Encryption (PHI at rest)
PHI_MASTER_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS
AUDIT_HMAC_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
ENCRYPTION_KEY=REPLACE_WITH_16_CHAR_STRING
INVITE_JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# Superadmin (REQUIRED — generate a strong random password before deploying)
# NEVER deploy with a default or weak password. Use: openssl rand -base64 32
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@clinic.com
SUPERADMIN_EMAIL=superadmin@clinic.com

# Error exposure (dev only — NEVER enable in production)
# EXPOSE_ERRORS=true

# File uploads
# UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# PostgreSQL (Docker — dev only)
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
