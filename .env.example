# ──────────────────────────────────────────────
# 🏥 Clínica — Environment Variables
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic
DATABASE_URL_READ_ONLY=          # Optional: read replica connection string
DB_SSL_REJECT_UNAUTHORIZED=true  # Set to 'false' only if using a self-signed CA
DB_CA_CERT=                      # CA certificate for TLS connections (e.g. AWS RDS)

# Server
PORT=3000
NODE_ENV=development

# URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# Frontend version (v3 is the current production frontend)

# JWT
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_SECRET_IN_PRODUCTION

# Invite JWT (must be different from JWT_SECRET)
INVITE_JWT_SECRET=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_SECRET

# Encryption key for 2FA secrets (min 16 chars; PBKDF2-derived)
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_HEX_0123456789ABCDEF

# Email (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# 2FA — TOTP issuer name
TOTP_ISSUER=ClinicApp

# SMS / WhatsApp (Twilio)
SMS_PROVIDER=log                   # log | twilio | whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Multi-tenancy
DEFAULT_TENANT_ID=default
APP_LOCALE=es                       # es | en | pt | fr
ALLOWED_DOMAINS=                    # Comma-separated parent domains for host header validation (e.g., clinic.com,app.clinic.com)

# Seed / Admin
SEED_ON_STARTUP=true                # true = seed runs every startup (dev); false = skipped in production
SEED_PASSWORD=REPLACED_PASSWORD              # Password used for seed users on first run
ADMIN_EMAIL=admin@clinic.com        # Email for the admin account
SUPERADMIN_EMAIL=superadmin@clinic.com  # Email for the superadmin account
SUPERADMIN_PASSWORD=CHANGE_ME       # Password for the superadmin account (REQUIRED in production)
COOKIE_SECRET=CHANGE_ME_RANDOM_32_CHARS_SECRET_KEY   # Secret for signed cookies (fallback: JWT_SECRET)

# Stripe (optional — simulated mode without valid key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# reCAPTCHA (Google)
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=           # Site key (pública) para frontend

# Sentry (optional — error tracking)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ML
ML_SIMPLIFIED=false                 # true = stats-only, no TensorFlow

# DB Pool
DB_POOL_MAX=20

# Audit HMAC Secret (REQUIRED for audit log integrity — min 32 chars)
AUDIT_HMAC_SECRET=CHANGE_ME_AUDIT_HMAC_SECRET_32_CHARS_MINIMUM

# PHI Master Key (REQUIRED for envelope encryption of clinical PHI — 64 hex chars = 32 bytes)
PHI_MASTER_KEY=0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF

# JWT RSA keys (alternative to filesystem keys/ directory — set both for production)
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...

# Logging
LOG_LEVEL=info
LOG_DIR=logs
